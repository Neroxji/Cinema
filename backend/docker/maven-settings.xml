<?xml version="1.0" encoding="UTF-8"?>
<!-- 容器内 Maven 构建用的镜像源配置（task-01C）：与宿主 ~/.m2/settings.xml 的
     阿里云 central 镜像保持一致，仅服务 backend/Dockerfile 构建阶段，不参与运行。 -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <mirrors>
    <mirror>
      <id>aliyunmaven</id>
      <mirrorOf>central</mirrorOf>
      <name>aliyun public (central mirror)</name>
      <url>https://maven.aliyun.com/repository/public</url>
    </mirror>
  </mirrors>
</settings>
